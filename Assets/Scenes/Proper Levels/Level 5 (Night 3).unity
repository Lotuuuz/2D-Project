  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Good God

    I shot one, I truly shot one


    They are guarding the
    door. It has become a dreadful stalemate


    They know I have more cartridges.
    How can they know that? Do they count?


    Why did we not come below tonight?
    Why? Why?


    The others are still upstairs asleep.


    Dear God.


    I
    hear footsteps upon the stairs


    I do not know which prospect is more terrible:
    that more of those creatures are descending, or that someone I love has come
    searching for me.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9a14a8a1184c5f14fbce3338ea4d7a35, type: 2}
